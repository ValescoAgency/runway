# VA-386 (dashboard slice 1): collector container for runway traces.
#
# Two-stage build: stage 1 installs deps and compiles TypeScript;
# stage 2 ships only dist/ + production node_modules. node:24 keeps
# `node:sqlite` available (it was added in v22.5.0 and stabilised in
# the v24 line). We use the `slim` variant — not alpine — because pnpm
# + native modules behave better against glibc.

FROM node:24-slim AS build
WORKDIR /app

# VA-393: install pnpm directly rather than going through corepack.
# Recent Node 24 + corepack combinations require an integrity hash in
# package.json#packageManager to auto-download a pinned pnpm version;
# without one, `pnpm install` fails non-interactively in CI. Direct
# `npm i -g` skips the corepack signature/prompt flow entirely. The
# version is kept in sync manually with package.json#packageManager
# (currently pnpm@11.1.1) — both lines are one-liners, so the
# drift risk is low and grep-discoverable.
RUN npm install -g pnpm@11.1.1
# pnpm 11 reads build-script approval from pnpm-workspace.yaml
# (`allowBuilds`); without it pnpm errors out on every install with
# ERR_PNPM_IGNORED_BUILDS. The `.npmrc` is also copied so any scope-
# routing rules (we pin @valescoagency to the public registry) apply
# inside the container as well.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
# `--frozen-lockfile` guarantees we install exactly what was resolved
# at commit time. The repo's `prepare` script (`lefthook install -f`)
# expects a `.git` dir and silently exits via `|| true` when it's
# missing — that's why we don't need to drag git into the build stage.
RUN pnpm install --frozen-lockfile

COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN pnpm build

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production

# `--experimental-sqlite` keeps the warning quiet on v22.x; v23+ no
# longer needs it but accepts it as a no-op (still set on v24 for
# defensive parity in case the runtime is ever pinned back).
ENV NODE_OPTIONS="--experimental-sqlite --no-warnings"

COPY package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

# Default data directory; docker-compose mounts a named volume here.
RUN mkdir -p /data
ENV SQLITE_PATH=/data/runway.sqlite
ENV OTLP_PORT=4318
ENV DASHBOARD_PORT=3001
# VA-385: server.ts defaults to 127.0.0.1 (loopback) so stand-alone
# `node dist/dashboard/server.js` is safe-by-default. Inside Docker
# the listener has to bind 0.0.0.0 so Docker's port-forward (published
# via docker-compose) can reach it. docker-compose then re-gates the
# host port to 127.0.0.1 via the `127.0.0.1:` prefix on `ports:`.
ENV DASHBOARD_HOST=0.0.0.0
EXPOSE 4318 3001

CMD ["node", "dist/dashboard/server.js"]
