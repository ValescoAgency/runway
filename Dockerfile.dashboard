# VA-386 (dashboard slice 1): collector container for runway traces.
#
# Two-stage build: stage 1 installs deps and compiles TypeScript;
# stage 2 ships only dist/ + production node_modules. node:22 is the
# baseline so `node:sqlite` is available (added in v22.5.0). We use
# the `slim` variant — not alpine — because pnpm + native modules
# behave better against glibc.

FROM node:22-slim AS build
WORKDIR /app

# Enable corepack-managed pnpm; the lockfile pins the version
# transitively via packageManager (when present). `--frozen-lockfile`
# guarantees we install exactly what was resolved at commit time.
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN pnpm build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production

# `--experimental-sqlite` keeps the warning quiet on v22.x; v23+ no
# longer needs it but accepts it as a no-op.
ENV NODE_OPTIONS="--experimental-sqlite --no-warnings"

COPY package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

# Default data directory; docker-compose mounts a named volume here.
RUN mkdir -p /data
ENV SQLITE_PATH=/data/runway.sqlite
ENV OTLP_PORT=4318
ENV DASHBOARD_PORT=3001
EXPOSE 4318 3001

CMD ["node", "dist/dashboard/server.js"]
