# Runway host-side secrets manifest.
#
# This file is the source of truth for which env vars runway needs at
# runtime. Real values are NEVER committed — varlock resolves the
# shell-resolver references against the host's 1Password CLI at the moment
# `varlock run -- runway` fires, then injects into process.env for the
# duration of the run. Values never touch disk.
#
# Usage:
#   varlock run -- runway              # drain queue
#   varlock run -- runway --max 3      # process at most 3 issues
#
# Auth model: 1Password service account (OP_SERVICE_ACCOUNT_TOKEN
# exported in the host shell). Account segment omitted from op:// URIs
# because the service-account token encodes the tenant.

# @sensitive @required
LINEAR_API_KEY=exec('op read "op://runway/linear-api-key"')

# Required for in-container secret resolution (Layer 2 — see
# docs/secrets-with-varlock.md). The container uses this to authenticate
# with 1Password and fetch ANTHROPIC_API_KEY, GH_TOKEN at agent runtime.
# @sensitive @required
OP_SERVICE_ACCOUNT_TOKEN=exec('op read "op://runway/op-service-account-token"')

# --- Optional knobs (no resolution needed) ---

# @optional
RUNWAY_LINEAR_TEAM=VA
# @optional
RUNWAY_READY_STATUS=Todo
# @optional
RUNWAY_IN_PROGRESS_STATUS=In Progress
# @optional
RUNWAY_IN_REVIEW_STATUS=In Review
# @optional
RUNWAY_HITL_LABEL=needs-human
# @optional @type=number
RUNWAY_MAX_ITERATIONS=5
