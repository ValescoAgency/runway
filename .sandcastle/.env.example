# --- Required ---

# Anthropic API key — used by claudeCode() inside the sandbox.
ANTHROPIC_API_KEY=

# GitHub personal access token (or fine-grained token) with repo + pr scope.
# Used inside the sandbox by Claude Code to push branches; also used on the
# host by runway to open PRs and read issue state.
GH_TOKEN=

# Linear API key — runway queries the queue and updates issue state.
# https://linear.app/settings/api
LINEAR_API_KEY=

# --- Required (for now) ---

# Absolute path on the host to the target repo runway operates against.
# v1 is single-repo. Multi-repo dispatch comes later.
RUNWAY_TARGET_REPO=

# --- Optional ---

# Linear team key (e.g. "VA"). If set, runway only pulls issues from this team.
RUNWAY_LINEAR_TEAM=VA

# Linear status name that means "ready for runway to pick up". Default: "Todo".
RUNWAY_READY_STATUS=Todo

# Linear status name to set while runway is working an issue. Default: "In Progress".
RUNWAY_IN_PROGRESS_STATUS=In Progress

# Linear status name to set when runway opens the PR. Default: "In Review".
RUNWAY_IN_REVIEW_STATUS=In Review

# Linear label runway applies when it gives up. Default: "needs-human".
RUNWAY_HITL_LABEL=needs-human

# Max iterations per agent run before runway gives up.
RUNWAY_MAX_ITERATIONS=5
