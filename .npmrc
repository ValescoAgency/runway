# Pin the @valescoagency scope to the public npm registry, overriding
# any host-level ~/.npmrc that routes the scope elsewhere (e.g. legacy
# AFK config pointing at https://npm.pkg.github.com). Without this, a
# local `pnpm publish` silently goes to the wrong registry.
#
# CI is unaffected — setup-node@v4 in release.yml already sets
# registry-url: https://registry.npmjs.org for the publish step.
@valescoagency:registry=https://registry.npmjs.org
